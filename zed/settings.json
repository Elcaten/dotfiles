// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "terminal": {
    "font_size": 13.0,
  },
  "vim_mode": false,
  "helix_mode": true,
  "ssh_connections": [
    {
      "host": "hetzner",
      "args": [],
      "projects": [
        {
          "paths": ["/root"],
        },
      ],
    },
    {
      "host": "homelab",
      "args": [],
      "projects": [
        {
          "paths": ["/home/admin"],
        },
      ],
    },
  ],
  "code_lens": "off",
  "toolbar": {
    "code_actions": true,
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "diff_view_style": "split",
  "git": {},
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "agent": {
    "default_profile": "write",
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "show_count_badge": false,
    "entry_primary_click_action": "file_diff",
    "diff_stats": false,
    "file_icons": true,
    "collapse_untracked_diff": false,
    "sort_by": "path",
    "status_style": "label_color",
    "group_by": "staging",
    "tree_view": true,
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "project_panel": {
    "diagnostic_badges": false,
    "git_status_indicator": true,
    "git_status": true,
    "dock": "right",
    "hide_root": true,
    "entry_spacing": "standard",
    "default_width": 300.0,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "edit_predictions": {
    "provider": "ollama",
    "mode": "eager",
    "ollama": {
      "api_url": "http://192.168.8.140:11434",
      "model": "qwen2.5-coder:7b-base-q4_K_M",
      "prompt_format": "qwen",
      "max_output_tokens": 256,
      "prediction_debounce": 150,
    },
  },
  "redact_private_values": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "minimap": {
    "show": "never",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "Zed",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "high",
        "collaboration_mode": "plan",
      },
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "theme": {
    "mode": "system",
    "light": "Alabaster",
    "dark": "macOS Classic Dark",
  },
}
