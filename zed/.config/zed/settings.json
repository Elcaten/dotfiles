{
  "git_panel": {
    "group_by": "staging"
  },
  "which_key": {
    "delay_ms": 350,
    "enabled": true
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.2-sol",
        "reasoning_effort": "medium"
      },
      "type": "registry",
    },
  },
  "use_system_path_prompts": false,
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
  },
  "buffer_line_height": "standard",
  "ui_font_family": "Ubuntu",
  "buffer_font_family": "Ubuntu Mono",
  "agent_buffer_font_size": 15.0,
  "buffer_font_size": 16.0,
  "double_click_in_multibuffer": "open",
  "vim_mode": false,
  "helix_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
